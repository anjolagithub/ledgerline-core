{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "dist"
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["script/**/*.ts"]
}

